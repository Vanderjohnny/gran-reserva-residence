# Gran Reserva Residence - Apache / cPanel rules (shipped inside the zip by tools/build_hostgator_zip.py; GitHub Pages ignores it)
Options -Indexes

# 3D and image types the server may not know
AddType model/gltf-binary .glb
AddType image/webp .webp
AddType application/json .json
AddType image/vnd.radiance .hdr

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json model/gltf-binary
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType model/gltf-binary "access plus 30 days"
  ExpiresByType image/vnd.radiance "access plus 30 days"
  ExpiresByType application/pdf "access plus 7 days"
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Hotlink protection (user request 2026-09-14): models, panoramas, renders, plans and the catalogue are only served to
# pages of the site's own domains. Requests without a Referer stay allowed (privacy modes, direct visits, the site's own
# module loads) - this stops other sites embedding the assets straight from this server, not a deliberate download.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_REFERER} !^$
  RewriteCond %{HTTP_REFERER} !^https?://([a-z0-9-]+\.)*unkviewer\.com(:[0-9]+)?(/|$) [NC]
  RewriteCond %{HTTP_REFERER} !^https?://([a-z0-9-]+\.)*jncempreendimentos\.com\.br(:[0-9]+)?(/|$) [NC]
  RewriteCond %{HTTP_REFERER} !^https?://vanderjohnny\.github\.io(/|$) [NC]
  RewriteCond %{HTTP_REFERER} !^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?(/|$) [NC]
  RewriteRule \.(glb|jpe?g|png|webp|hdr|pdf|json)$ - [F,NC]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
